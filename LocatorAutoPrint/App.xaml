<Application x:Class="LocatorAutoPrint.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:LocatorAutoPrint.Helpers">
    <Application.Resources>
        <ResourceDictionary>

            <!-- 0. CONVERTERS -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <helpers:InverseBooleanConverter x:Key="InverseBoolConverter"/>
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

            <!-- 1. PUREGOLD BRAND COLOR PALETTE -->
            <!-- Primary Emerald Green -->
            <Color x:Key="Color.BrandGreen">#006837</Color>
            <Color x:Key="Color.BrandDarkGreen">#004D28</Color>
            <Color x:Key="Color.BrandLightGreen">#E8F5E9</Color>

            <!-- Accent Puregold Yellow & Gold -->
            <Color x:Key="Color.BrandYellow">#FFD200</Color>
            <Color x:Key="Color.BrandGold">#FDB913</Color>

            <!-- Slate & Neutral Dark -->
            <Color x:Key="Color.DarkSlate">#1E293B</Color>
            <Color x:Key="Color.TextSlate">#334155</Color>

            <!-- Clean Containers & Dividers -->
            <Color x:Key="Color.White">#FFFFFF</Color>
            <Color x:Key="Color.CardBg">#F8FAFC</Color>
            <Color x:Key="Color.WindowBg">#F1F5F9</Color>
            <Color x:Key="Color.BorderGray">#CBD5E1</Color>

            <!-- Solid Brushes -->
            <SolidColorBrush x:Key="Brush.BrandGreen" Color="{StaticResource Color.BrandGreen}"/>
            <SolidColorBrush x:Key="Brush.BrandDarkGreen" Color="{StaticResource Color.BrandDarkGreen}"/>
            <SolidColorBrush x:Key="Brush.BrandLightGreen" Color="{StaticResource Color.BrandLightGreen}"/>
            <SolidColorBrush x:Key="Brush.BrandYellow" Color="{StaticResource Color.BrandYellow}"/>
            <SolidColorBrush x:Key="Brush.BrandGold" Color="{StaticResource Color.BrandGold}"/>
            <SolidColorBrush x:Key="Brush.DarkSlate" Color="{StaticResource Color.DarkSlate}"/>
            <SolidColorBrush x:Key="Brush.TextSlate" Color="{StaticResource Color.TextSlate}"/>
            <SolidColorBrush x:Key="Brush.White" Color="{StaticResource Color.White}"/>
            <SolidColorBrush x:Key="Brush.CardBg" Color="{StaticResource Color.CardBg}"/>
            <SolidColorBrush x:Key="Brush.LightGray" Color="{StaticResource Color.WindowBg}"/>
            <SolidColorBrush x:Key="Brush.NeutralGray" Color="{StaticResource Color.BorderGray}"/>

            <!-- Brand-Aligned Mappings for Global Consistency -->
            <SolidColorBrush x:Key="Brush.PrimaryYellow" Color="{StaticResource Color.BrandYellow}"/>
            <SolidColorBrush x:Key="Brush.PrimaryBlue" Color="{StaticResource Color.BrandGreen}"/>
            <SolidColorBrush x:Key="Brush.DarkBlue" Color="{StaticResource Color.DarkSlate}"/>

            <!-- 2. TYPOGRAPHY -->
            <Style x:Key="Text.Header" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.DarkSlate}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="Text.Body" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSlate}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- 3. BASE BUTTON TEMPLATE -->
            <Style x:Key="ModernButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Brush.BrandGreen}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#008444"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.BrandDarkGreen}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- MODERN PROGRESS BAR -->
            <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
                <Setter Property="Background" Value="{StaticResource Brush.LightGray}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.BrandYellow}"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <!-- 4. DERIVED ACTION BUTTONS -->
            <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
                <Setter Property="Background" Value="{StaticResource Brush.BrandGreen}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BrandDarkGreen}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#008444"/>
                        <Setter Property="BorderBrush" Value="#008444"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
                <Setter Property="Background" Value="{StaticResource Brush.White}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.BrandGreen}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.NeutralGray}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.BrandLightGreen}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BrandGreen}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WarningActionButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
                <Setter Property="Background" Value="{StaticResource Brush.BrandGold}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.DarkSlate}"/>
                <Setter Property="BorderBrush" Value="#E09E0B"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.BrandYellow}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BrandYellow}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DestructiveActionButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
                <Setter Property="Background" Value="{StaticResource Brush.White}"/>
                <Setter Property="Foreground" Value="#E74C3C"/>
                <Setter Property="BorderBrush" Value="#E74C3C"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FDEDEC"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 5. NAVIGATION PILL BUTTONS -->
            <Style x:Key="NavPillButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSlate}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,3,0"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActiveNavPillButton" TargetType="Button" BasedOn="{StaticResource NavPillButton}">
                <Setter Property="Background" Value="{StaticResource Brush.BrandGreen}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.BrandDarkGreen}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 6. MODERN TEXTBOX -->
            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource Brush.White}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.DarkSlate}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.NeutralGray}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.BrandGreen}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.BrandGreen}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                    <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 7. MODERN TAB CONTROL -->
            <Style x:Key="ModernTabControl" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            <Style x:Key="ModernTabItem" TargetType="TabItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSlate}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="border" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2.5" Padding="10,7" Margin="0,0,4,0" Cursor="Hand">
                                <ContentPresenter x:Name="content" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.NeutralGray}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.BrandGreen}"/>
                                    <Setter TargetName="content" Property="TextBlock.Foreground" Value="{StaticResource Brush.BrandGreen}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 8. MODERN HIGH-DENSITY DATAGRID -->
            <Style x:Key="ModernDataGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource Brush.White}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.DarkSlate}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.NeutralGray}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowBackground" Value="{StaticResource Brush.White}"/>
                <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DCFCE7"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#004D28"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F0FDF4"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#004D28"/>
                            </Style.Resources>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ModernDataGridColumnHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource Brush.BrandDarkGreen}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BrandDarkGreen}"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="SeparatorBrush" Value="{StaticResource Brush.BrandDarkGreen}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>