<UserControl x:Class="LocatorAutoPrint.Views.UserControls.LocatorPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Stretch" 
             Background="{StaticResource Brush.LightGray}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="165"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP QUICK ACTIONS / HELP TOOLBAR -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
            <Button Command="{Binding ShowGuideCommand}" Style="{StaticResource SecondaryActionButton}" Padding="8,4" Margin="0,0,6,0" ToolTip="User Guide">
                <fa:IconBlock Icon="CircleQuestion" FontSize="12"/>
            </Button>
            <Button Command="{Binding ShowHowToCommand}" Style="{StaticResource SecondaryActionButton}" Padding="8,4" Margin="0,0,6,0" ToolTip="How to Use">
                <fa:IconBlock Icon="Lightbulb" FontSize="12"/>
            </Button>
            <Button Command="{Binding ShowAppInfoCommand}" Style="{StaticResource SecondaryActionButton}" Padding="8,4" ToolTip="App Info">
                <fa:IconBlock Icon="CircleInfo" FontSize="12"/>
            </Button>
        </StackPanel>

        <!-- INPUT CARD -->
        <Border Grid.Row="1" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Locator(s):" Style="{StaticResource Text.Header}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBox x:Name="LocatorInputBox" 
                             Text="{Binding LocatorInput, UpdateSourceTrigger=PropertyChanged}" 
                             IsEnabled="{Binding IsPrinting, Converter={StaticResource InverseBoolConverter}}"
                             Style="{StaticResource ModernTextBox}" 
                             Height="32"
                             Padding="8,6"
                             ToolTip="Enter locator numbers separated by commas (e.g. 1,2,3 or 34,87,100)"/>
                    <TextBlock Text="e.g., 1,2,3 or 34,87,100" 
                               Foreground="#94A3B8" 
                               FontSize="11" 
                               FontStyle="Italic"
                               VerticalAlignment="Center" 
                               Margin="9,0,0,0" 
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=LocatorInputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="2" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryActionButton}" Width="100" Height="32" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Print" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="Print"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- LIVE PROGRESS HEADER -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <fa:IconBlock Icon="ChartLine" Foreground="{StaticResource Brush.PrimaryBlue}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Live Progress Tracking" Style="{StaticResource Text.Header}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryActionButton}" Height="28" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="ArrowsRotate" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Refresh" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 4 PROGRESS METRIC CARDS -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CARD 1: OVERALL -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Margin="0,0,5,5" Padding="10">
                <Grid>
                    <TextBlock Text="OVERALL" Style="{StaticResource Text.Header}" FontSize="11" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Stats.Overall.Pct, StringFormat={}{0:N2}%}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryBlue}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <TextBlock VerticalAlignment="Bottom" FontSize="9" Foreground="#64748B" TextWrapping="NoWrap">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Done: {0:0} | Cxl: {1:0} | Tot: {2:0} | Rem: {3:0}">
                                <Binding Path="Stats.Overall.Comp"/>
                                <Binding Path="Stats.Overall.Cancel"/>
                                <Binding Path="Stats.Overall.Total"/>
                                <Binding Path="Stats.Overall.Rem"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- CARD 2: SELLING -->
            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Margin="5,0,0,5" Padding="10">
                <Grid>
                    <TextBlock Text="SELLING" Style="{StaticResource Text.Header}" FontSize="11" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Stats.Selling.Pct, StringFormat={}{0:N2}%}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryBlue}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <TextBlock VerticalAlignment="Bottom" FontSize="9" Foreground="#64748B" TextWrapping="NoWrap">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Done: {0:0} | Cxl: {1:0} | Tot: {2:0} | Rem: {3:0}">
                                <Binding Path="Stats.Selling.Comp"/>
                                <Binding Path="Stats.Selling.Cancel"/>
                                <Binding Path="Stats.Selling.Total"/>
                                <Binding Path="Stats.Selling.Rem"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- CARD 3: WAREHOUSE -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Margin="0,5,5,0" Padding="10">
                <Grid>
                    <TextBlock Text="WAREHOUSE" Style="{StaticResource Text.Header}" FontSize="11" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Stats.Warehouse.Pct, StringFormat={}{0:N2}%}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryBlue}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <TextBlock VerticalAlignment="Bottom" FontSize="9" Foreground="#64748B" TextWrapping="NoWrap">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Done: {0:0} | Cxl: {1:0} | Tot: {2:0} | Rem: {3:0}">
                                <Binding Path="Stats.Warehouse.Comp"/>
                                <Binding Path="Stats.Warehouse.Cancel"/>
                                <Binding Path="Stats.Warehouse.Total"/>
                                <Binding Path="Stats.Warehouse.Rem"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- CARD 4: BUFFER -->
            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Margin="5,5,0,0" Padding="10">
                <Grid>
                    <TextBlock Text="BUFFER / TOPLOAD" Style="{StaticResource Text.Header}" FontSize="11" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Stats.Buffer.Pct, StringFormat={}{0:N2}%}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryBlue}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <TextBlock VerticalAlignment="Bottom" FontSize="9" Foreground="#64748B" TextWrapping="NoWrap">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Done: {0:0} | Cxl: {1:0} | Tot: {2:0} | Rem: {3:0}">
                                <Binding Path="Stats.Buffer.Comp"/>
                                <Binding Path="Stats.Buffer.Cancel"/>
                                <Binding Path="Stats.Buffer.Total"/>
                                <Binding Path="Stats.Buffer.Rem"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ACTION BAR -->
        <Border Grid.Row="4" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding OpenCountsheetListCommand}" Style="{StaticResource SecondaryActionButton}" Height="30" Padding="12,0" Margin="0,0,8,0" FontSize="11" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock Icon="ListCheck" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Countsheet List" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenPrelocMaintenanceCommand}" Style="{StaticResource SecondaryActionButton}" Height="30" Padding="12,0" Margin="0,0,8,0" FontSize="11" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock Icon="Gears" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PRELOC Maintenance" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RestoreLocatorCommand}" Style="{StaticResource SecondaryActionButton}" Height="30" Padding="12,0" FontSize="11" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock Icon="RotateLeft" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Restore Locator" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- LOADING OVERLAY -->
        <Border Grid.Row="0" Grid.RowSpan="5" 
                Background="#CCFFFFFF" 
                Panel.ZIndex="100" 
                CornerRadius="6"
                Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVis}}">

            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{x:Static ApplicationCommands.NotACommand}" />
            </Border.InputBindings>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <fa:IconBlock Icon="CircleNotch" FontSize="44" Foreground="{StaticResource Brush.PrimaryBlue}" HorizontalAlignment="Center" Margin="0,0,0,14" RenderTransformOrigin="0.5,0.5">
                    <fa:IconBlock.RenderTransform>
                        <RotateTransform Angle="0" />
                    </fa:IconBlock.RenderTransform>
                    <fa:IconBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" 
                                                     From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </fa:IconBlock.Triggers>
                </fa:IconBlock>
                <TextBlock Text="Printing Locators..." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.DarkBlue}" HorizontalAlignment="Center"/>
                <TextBlock Text="Please wait. Do not close the application." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>