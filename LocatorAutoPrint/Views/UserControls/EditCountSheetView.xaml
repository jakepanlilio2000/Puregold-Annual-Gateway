<UserControl x:Class="LocatorAutoPrint.Views.UserControls.EditCountSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
             Background="{StaticResource Brush.LightGray}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER & ACTIONS BAR -->
        <Border Grid.Row="0" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="FilePen" Foreground="{StaticResource Brush.PrimaryBlue}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Edit Count Sheet" Style="{StaticResource Text.Header}" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding AddRecordCommand}" Style="{StaticResource SecondaryActionButton}" Width="72" Height="30" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Plus" FontSize="10" Margin="0,0,5,0"/>
                            <TextBlock Text="Add" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding EditCommand}" IsEnabled="{Binding IsViewMode}" Style="{StaticResource SecondaryActionButton}" Width="72" Height="30" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="PenToSquare" FontSize="10" Margin="0,0,5,0"/>
                            <TextBlock Text="Edit" FontSize="11"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditMode}" Style="{StaticResource PrimaryActionButton}" Width="72" Height="30" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="FloppyDisk" FontSize="10" Margin="0,0,5,0"/>
                            <TextBlock Text="Save" FontSize="11"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelCommand}" IsEnabled="{Binding IsEditMode}" Style="{StaticResource SecondaryActionButton}" Width="72" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Xmark" FontSize="10" Margin="0,0,5,0"/>
                            <TextBlock Text="Cancel" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LOCATOR & RECORD SEARCH BAR -->
        <Border Grid.Row="1" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Locator:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Text.Body}" FontSize="12" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Text="{Binding SearchLocator, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>

                <TextBlock Grid.Column="2" Text="Record No:" VerticalAlignment="Center" Margin="12,0,6,0" Style="{StaticResource Text.Body}" FontSize="12" FontWeight="SemiBold"/>
                <TextBox Grid.Column="3" Text="{Binding SearchRecNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>

                <Button Grid.Column="5" Command="{Binding PrintEditedCommand}" Style="{StaticResource SecondaryActionButton}" Height="28" Padding="10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Print" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="Print Edited" FontSize="11"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- RECORD DETAILS FORM -->
        <Border Grid.Row="2" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="UPC:" VerticalAlignment="Center" Style="{StaticResource Text.Body}" FontSize="12" FontWeight="SemiBold"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentRecord.UPC, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditMode}" Style="{StaticResource ModernTextBox}" Height="28" Margin="0,0,8,0" LostFocus="AutoSearch_LostFocus"/>

                <Button Grid.Row="0" Grid.Column="2" Command="{Binding SearchItemCommand}" IsEnabled="{Binding IsEditMode}" Style="{StaticResource SecondaryActionButton}" Height="28" Padding="8,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="MagnifyingGlass" FontSize="10" Margin="0,0,5,0"/>
                        <TextBlock Text="Search Masterfile" FontSize="11"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="SKU:" VerticalAlignment="Center" Margin="0,10,0,0" Style="{StaticResource Text.Body}" FontSize="12" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CurrentRecord.SKU, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditMode}" Style="{StaticResource ModernTextBox}" Height="28" Margin="0,10,0,0" LostFocus="AutoSearch_LostFocus"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Description:" VerticalAlignment="Top" Margin="0,10,0,0" Style="{StaticResource Text.Body}" FontSize="12" FontWeight="SemiBold"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CurrentRecord.Descr, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditMode}" Style="{StaticResource ModernTextBox}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Quantity:" VerticalAlignment="Center" Margin="0,10,0,0" FontWeight="Bold" Style="{StaticResource Text.Body}" FontSize="12"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentRecord.EditedQty, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditMode}" Style="{StaticResource ModernTextBox}" Height="28" Margin="0,10,8,0"/>

                <Border Grid.Row="3" Grid.Column="2" Background="{StaticResource Brush.LightGray}" CornerRadius="4" Padding="8,4" Margin="0,10,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentRecord.OriginalQty, StringFormat='Original Count: {0}'}" Foreground="#555555" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- LOADING / PROCESSING OVERLAY -->
        <Border Grid.Row="0" Grid.RowSpan="3" 
                Background="#CCFFFFFF" 
                Panel.ZIndex="100" 
                CornerRadius="6"
                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">

            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{x:Static ApplicationCommands.NotACommand}" />
            </Border.InputBindings>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <fa:IconBlock Icon="CircleNotch" FontSize="40" Foreground="{StaticResource Brush.PrimaryBlue}" HorizontalAlignment="Center" Margin="0,0,0,14" RenderTransformOrigin="0.5,0.5">
                    <fa:IconBlock.RenderTransform>
                        <RotateTransform Angle="0" />
                    </fa:IconBlock.RenderTransform>
                    <fa:IconBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" 
                                                     From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </fa:IconBlock.Triggers>
                </fa:IconBlock>

                <TextBlock Text="Processing..." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.DarkBlue}" HorizontalAlignment="Center"/>
                <TextBlock Text="Please wait. Do not close the application." FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>