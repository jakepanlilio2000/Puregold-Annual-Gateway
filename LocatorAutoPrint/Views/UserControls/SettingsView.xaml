<UserControl x:Class="LocatorAutoPrint.Views.UserControls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
             Background="{StaticResource Brush.LightGray}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Brush.White}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.DarkSlate}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.NeutralGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.BrandGreen}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.BrandGreen}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="{StaticResource Brush.White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.NeutralGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MAIN TABBED SETTINGS PANELS -->
        <TabControl Grid.Row="0" Style="{StaticResource ModernTabControl}" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- TAB 1: CONNECTION & NETWORK SETTINGS -->
            <TabItem Style="{StaticResource ModernTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock Icon="NetworkWired" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Network &amp; DB" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <StackPanel>

                        <!-- Card 1.1: Database Connection Parameters -->
                        <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <fa:IconBlock Icon="Database" Foreground="{StaticResource Brush.BrandGreen}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Database Connection Parameters" Style="{StaticResource Text.Header}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Host and Port Row -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Database Host / IP" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding DbHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Port (e.g. 1433)" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding DbPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Catalog and Username Row -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Database Catalog / Name" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding DbCatalog, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Username" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Password Row -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Password" Style="{StaticResource SettingLabel}"/>
                                        <Grid>
                                            <PasswordBox x:Name="DbPasswordBox" PasswordChanged="DbPasswordBox_PasswordChanged" Style="{StaticResource ModernPasswordBox}" Height="28"
                                                         Visibility="{Binding ShowPassword, Converter={StaticResource InverseBoolToVis}}"/>
                                            <TextBox Text="{Binding DbPass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"
                                                     Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowPassword}" Content="Show" FontSize="11" Foreground="#475569" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                </Grid>

                                <!-- Connection Diagnostic Feedback Box -->
                                <Border Background="{Binding TestStatusBackground}" BorderBrush="{Binding TestStatusColor}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <fa:IconBlock Grid.Column="0" Icon="InfoCircle" Foreground="{Binding TestStatusColor}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TestMessage}" Foreground="{Binding TestStatusColor}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 1.2: FTP Update Repository Settings -->
                        <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <fa:IconBlock Icon="CloudArrowDown" Foreground="{StaticResource Brush.BrandGreen}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Intranet Update Repository (FTP)" Style="{StaticResource Text.Header}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- FTP Host and Timeout -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="FTP Server IP / Host" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding FtpHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Timeout (sec)" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding FtpTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Directory Path and Prefix -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Remote Directory Path" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding FtpDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="File Prefix" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding FtpPrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: CORRECTIONS & DATA ADJUSTMENT SETTINGS -->
            <TabItem Style="{StaticResource ModernTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock Icon="Sliders" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Corrections &amp; Data" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <StackPanel>

                        <!-- Card 2.1: Store Code & Terminal Mapping -->
                        <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <fa:IconBlock Icon="Store" Foreground="{StaticResource Brush.BrandGreen}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Store Identity" Style="{StaticResource Text.Header}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Store Code" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding StoreCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Store Name / Fallback Title" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding FallbackStoreName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2.2: Operational Tolerances & Timers -->
                        <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <fa:IconBlock Icon="ClockRotateLeft" Foreground="{StaticResource Brush.BrandGreen}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Operational Tolerances &amp; Timers" Style="{StaticResource Text.Header}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Variance / Discrepancy Tolerance" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding ToleranceLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Live Polling Interval (sec)" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Text="EOD &amp; Variance Date Format" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox ItemsSource="{Binding AvailableDateFormats}" SelectedItem="{Binding DateFormat}" Style="{StaticResource SettingsComboBox}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: OPERATIONAL VARIABLES & PATHS -->
            <TabItem Style="{StaticResource ModernTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock Icon="FolderTree" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Paths &amp; Preferences" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <StackPanel>

                        <!-- Card 3.1: File & Directory Storage -->
                        <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <fa:IconBlock Icon="FolderOpen" Foreground="{StaticResource Brush.BrandGreen}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Storage &amp; Output Directories" Style="{StaticResource Text.Header}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Local Export / Output Directory" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Local Diagnostics Log Directory" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Update Binary Download Directory" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3.2: Application Preferences -->
                        <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <fa:IconBlock Icon="Gear" Foreground="{StaticResource Brush.BrandGreen}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Runtime Preferences &amp; Presets" Style="{StaticResource Text.Header}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox IsChecked="{Binding AutoCheckUpdates}" Margin="0,4,0,6" VerticalAlignment="Center">
                                    <TextBlock Text="Automatically check for intranet updates on startup" FontSize="11" Foreground="#334155"/>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding VerboseLogging}" VerticalAlignment="Center">
                                    <TextBlock Text="Enable verbose telemetry and diagnostic trace logging" FontSize="11" Foreground="#334155"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- BOTTOM ACTION BAR: Fixed Bottom -->
        <Border Grid.Row="1" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
            <Grid>
                <Button Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource SecondaryActionButton}" Height="28" Padding="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Reset form to factory defaults">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock Icon="RotateLeft" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Restore Defaults" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryActionButton}" Height="28" Padding="10,0" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Test network ping and SQL Server handshake">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="Plug" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Test Connection" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryActionButton}" Height="28" Padding="12,0" VerticalAlignment="Center" ToolTip="Persist settings to config.json and apply">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="FloppyDisk" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save &amp; Apply" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>

