<UserControl x:Class="LocatorAutoPrint.Views.UserControls.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
             Background="{StaticResource Brush.LightGray}">
    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP PANEL: FORM CARD -->
        <Border Grid.Row="0" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock Icon="UserGear" Foreground="{StaticResource Brush.PrimaryBlue}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="User Management" Style="{StaticResource Text.Header}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Command="{Binding ClearFormCommand}" Style="{StaticResource SecondaryActionButton}" Height="28" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="Eraser" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear Form" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="User Identifier (Name, Username &amp; Password)" Style="{StaticResource Text.Body}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SingleInputName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Command="{Binding AddUserCommand}" Style="{StaticResource PrimaryActionButton}" Height="28" Margin="0,0,4,6">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="UserPlus" FontSize="10" Margin="0,0,5,0"/>
                            <TextBlock Text="Add User" FontSize="11"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="0" Grid.Column="1" Command="{Binding EditUserCommand}" Style="{StaticResource SecondaryActionButton}" Height="28" Margin="4,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="UserPen" FontSize="10" Margin="0,0,5,0"/>
                            <TextBlock Text="Update Selected" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="0" Command="{Binding LogoutMobileAppCommand}" Style="{StaticResource WarningActionButton}" Height="28" Margin="0,0,4,0" ToolTip="Clears IP and active locator for selected user">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="MobileScreen" FontSize="10" Margin="0,0,5,0"/>
                            <TextBlock Text="Logout Mobile" FontSize="11"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1" Command="{Binding DeleteUserCommand}" Style="{StaticResource DestructiveActionButton}" Height="28" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Trash" FontSize="10" Margin="0,0,5,0"/>
                            <TextBlock Text="Delete Selected" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- BOTTOM PANEL: DATAGRID CARD -->
        <Border Grid.Row="1" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock Icon="Users" Foreground="{StaticResource Brush.PrimaryBlue}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="System Users" Style="{StaticResource Text.Header}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Command="{Binding LoadUsersCommand}" Style="{StaticResource SecondaryActionButton}" Height="28" Width="110" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="ArrowsRotate" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh List" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding UsersList}" SelectedItem="{Binding SelectedUser}" 
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ModernDataGrid}" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding IpAddress}">
                                        <Ellipse Width="10" Height="10" StrokeThickness="1">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#BDC3C7"/>
                                                    <Setter Property="Stroke" Value="#7F8C8D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="#2ECC71"/>
                                                            <Setter Property="Stroke" Value="#27AE60"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Last Login" Binding="{Binding LastLogin, StringFormat={}{0:MM/dd HH:mm}}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Active Loc" Binding="{Binding ActiveLocator}" Width="75" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Session" Binding="{Binding IsLogin, Mode=OneWay}" Width="55" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>