<Window x:Class="LocatorAutoPrint.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocatorAutoPrint.ViewModels"
        xmlns:views="clr-namespace:LocatorAutoPrint.Views.UserControls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Puregold Annual Gateway v3.5" 
        Width="565" Height="565" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Background="{StaticResource Brush.LightGray}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <!-- Header -->
            <RowDefinition Height="46"/>
            <!-- Top Navigation -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="28"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER: Puregold Deep Emerald Green Bar -->
        <Border Grid.Row="0" Background="{StaticResource Brush.BrandGreen}">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="Store" Foreground="{StaticResource Brush.BrandYellow}" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PUREGOLD" Foreground="{StaticResource Brush.BrandYellow}" FontWeight="ExtraBold" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="GATEWAY v3.5" Foreground="{StaticResource Brush.White}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    
                    <!-- Host Badge -->
                    <Border Background="{StaticResource Brush.BrandDarkGreen}" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HostMachineName}" Foreground="#A7F3D0" FontSize="10" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Active Local IPv4 Telemetry Badge -->
                    <Border CornerRadius="3" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Brush.BrandDarkGreen}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIpConnected}" Value="False">
                                        <Setter Property="Background" Value="#7F1D1D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="NetworkWired" Foreground="{StaticResource Brush.BrandYellow}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HeaderIpDisplay}" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A7F3D0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIpConnected}" Value="False">
                                                <Setter Property="Foreground" Value="#FCA5A5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Foreground="#D1FAE5" FontSize="10" VerticalAlignment="Center">
                        <Run Text="Sessions: "/>
                    </TextBlock>
                    <Border Background="{StaticResource Brush.BrandDarkGreen}" CornerRadius="10" Padding="7,1" Margin="2,0,0,0">
                        <TextBlock Text="{Binding HeaderStatus.OnlineConnections, Mode=OneWay}" 
                                   Foreground="{StaticResource Brush.BrandYellow}" 
                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NAVIGATION: 5 Horizontal Pill Tabs with Active Highlights -->
        <Border Grid.Row="1" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">

                <!-- 1. Print Locator -->
                <Button Command="{Binding ShowPrintCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPrintActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.BrandGreen}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Print" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="Print"/>
                    </StackPanel>
                </Button>

                <!-- 2. Edit Count Sheet -->
                <Button Command="{Binding ShowEditCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.BrandGreen}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="FilePen" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="Edit Sheet"/>
                    </StackPanel>
                </Button>

                <!-- 3. Reports -->
                <Button Command="{Binding ShowReportsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReportsActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.BrandGreen}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="ChartColumn" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="Reports"/>
                    </StackPanel>
                </Button>

                <!-- 4. Users -->
                <Button Command="{Binding ShowUsersCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUsersActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.BrandGreen}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Users" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="Users"/>
                    </StackPanel>
                </Button>



                <!-- 5. Settings (Decoupled Configuration) -->
                <Button Command="{Binding ShowSettingsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.BrandGreen}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Sliders" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </Button>

                <!-- 6. About / Support & Updater -->
                <Button Command="{Binding ShowAboutCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAboutActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.BrandGreen}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="CircleInfo" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="About"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- CONTENT AREA -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type local:LocatorPrintViewModel}">
                    <views:LocatorPrintView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:EditCountSheetViewModel}">
                    <views:EditCountSheetView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:ReportsViewModel}">
                    <views:ReportsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:UsersViewModel}">
                    <views:UsersView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:SettingsViewModel}">
                    <views:SettingsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:AboutViewModel}">
                    <views:AboutView />
                </DataTemplate>

            </ContentControl.Resources>
        </ContentControl>

        <!-- FOOTER: Status & Live Clock -->
        <Border Grid.Row="3" Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="Database" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center">
                        <fa:IconBlock.Style>
                            <Style TargetType="fa:IconBlock">
                                <Setter Property="Foreground" Value="#006837"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DbStatus}" Value="SQL Server Disconnected">
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </fa:IconBlock.Style>
                    </fa:IconBlock>
                    <TextBlock Text="{Binding FooterDbDisplay, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#006837"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DbStatus}" Value="SQL Server Disconnected">
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <fa:IconBlock Icon="Clock" Foreground="{StaticResource Brush.NeutralGray}" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentTime}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>