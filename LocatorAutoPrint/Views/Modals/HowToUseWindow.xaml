<Window x:Class="LocatorAutoPrint.Views.Modals.HowToUseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Comprehensive User Guide (v3.5)" Width="550" Height="480" 
        WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow" 
        Background="{StaticResource Brush.LightGray}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER CARD -->
        <Border Grid.Row="0" Background="{StaticResource Brush.BrandGreen}" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="BookOpen" Foreground="{StaticResource Brush.BrandYellow}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Puregold Annual Gateway (v3.5)" Foreground="{StaticResource Brush.BrandYellow}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Store Operations &amp; Troubleshooting Guide" Foreground="{StaticResource Brush.White}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Background="{StaticResource Brush.BrandDarkGreen}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="v3.5" Foreground="{StaticResource Brush.BrandYellow}" FontWeight="Bold" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <!-- SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Section 1 -->
                <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="Print" Foreground="{StaticResource Brush.BrandGreen}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="1. Printing Locators &amp; Auto-Backup" Style="{StaticResource Text.Header}" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="• Enter locator numbers separated by commas (e.g., 1,2,3 or 34,87,100). No other formats are supported.&#x0a;• Click 'Print' to initiate printing. The system automatically verifies if the locator is closed and backs up the countsheet to an 89-character fixed-width text backup file before routing to the default printer." TextWrapping="Wrap" Style="{StaticResource Text.Body}" Foreground="#475569"/>
                    </StackPanel>
                </Border>

                <!-- Section 2 -->
                <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="FilePen" Foreground="{StaticResource Brush.BrandGreen}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="2. Editing Count Sheets &amp; Masterfile Search" Style="{StaticResource Text.Header}" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="• Switch to the 'Edit Sheet' tab.&#x0a;• Enter the Locator and Record No. to load the item.&#x0a;• UPC and SKU fields support automatic Masterfile queries upon pressing Enter or losing focus.&#x0a;• Only 'Quantity', 'UPC', 'SKU', and 'Description' are editable. The original physical count remains protected." TextWrapping="Wrap" Style="{StaticResource Text.Body}" Foreground="#475569"/>
                    </StackPanel>
                </Border>

                <!-- Section 3 -->
                <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="ChartColumn" Foreground="{StaticResource Brush.BrandGreen}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="3. Reports &amp; Masterfile Inquiry" Style="{StaticResource Text.Header}" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="• INF Report: Audit and print 'Item Not Found' discrepancies.&#x0a;• SKU Inquiry: Search items directly from the Masterfile with right-click clipboard copy options.&#x0a;• Summary: View real-time aggregated records, quantities, and SKU counts per locator.&#x0a;• Stock Value: Monitor unit costs and calculated total inventory valuation." TextWrapping="Wrap" Style="{StaticResource Text.Body}" Foreground="#475569"/>
                    </StackPanel>
                </Border>

                <!-- Section 4 -->
                <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="Users" Foreground="{StaticResource Brush.BrandGreen}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="4. User Management &amp; Mobile App Sessions" Style="{StaticResource Text.Header}" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="• Monitor online mobile scanner devices and active locators. Status dots indicate live connectivity.&#x0a;• Use 'Logout Mobile' to release hung scanner sessions without restarting the server." TextWrapping="Wrap" Style="{StaticResource Text.Body}" Foreground="#475569"/>
                    </StackPanel>
                </Border>

                <!-- Section 5 -->
                <Border Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.NeutralGray}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="CloudArrowDown" Foreground="{StaticResource Brush.BrandGreen}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="5. Software Updates &amp; IT Support" Style="{StaticResource Text.Header}" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="• Check the 'About' tab to verify the current software build and connect to the local store repository (192.168.200.177).&#x0a;• If an updated version is detected (e.g. A&amp;VG3.6.exe), click 'Download Update' to retrieve the installer directly to the Desktop.&#x0a;• For escalation, contact Store IT at Local 722." TextWrapping="Wrap" Style="{StaticResource Text.Body}" Foreground="#475569"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>